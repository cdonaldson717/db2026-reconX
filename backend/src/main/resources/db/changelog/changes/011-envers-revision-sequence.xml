<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Hibernate Envers 6 uses this sequence for revision identifiers. -->
    <changeSet id="011-create-revinfo-sequence-postgresql" author="reconx-team">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <not><sequenceExists sequenceName="revinfo_seq"/></not>
        </preConditions>
        <createSequence sequenceName="revinfo_seq" startValue="1" incrementBy="50"/>
        <rollback>
            <dropSequence sequenceName="revinfo_seq"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
