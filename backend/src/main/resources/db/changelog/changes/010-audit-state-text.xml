<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Keep the audit payload columns portable. Hibernate expects a character
      type here, while CLOB is reported differently by PostgreSQL and H2.
    -->
    <changeSet id="010-audit-state-text-postgresql" author="reconx-team">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <modifyDataType tableName="audit_log" columnName="before_state" newDataType="TEXT"/>
        <modifyDataType tableName="audit_log" columnName="after_state" newDataType="TEXT"/>
        <rollback>
            <modifyDataType tableName="audit_log" columnName="before_state" newDataType="CLOB"/>
            <modifyDataType tableName="audit_log" columnName="after_state" newDataType="CLOB"/>
        </rollback>
    </changeSet>

    <!-- H2 reports its TEXT alias as CLOB, so use a large VARCHAR instead. -->
    <changeSet id="010-audit-state-text-h2" author="reconx-team">
        <preConditions onFail="MARK_RAN">
            <dbms type="h2"/>
        </preConditions>
        <modifyDataType tableName="audit_log" columnName="before_state" newDataType="VARCHAR(1000000)"/>
        <modifyDataType tableName="audit_log" columnName="after_state" newDataType="VARCHAR(1000000)"/>
        <rollback>
            <modifyDataType tableName="audit_log" columnName="before_state" newDataType="CLOB"/>
            <modifyDataType tableName="audit_log" columnName="after_state" newDataType="CLOB"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
