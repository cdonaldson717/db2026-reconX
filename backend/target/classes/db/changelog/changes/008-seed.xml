<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV017 — Seed data (counterparties, instruments, sample trades, users)
 WHAT:    Loads CSV files baked into the JAR.
 HOW:     <loadData> reads from classpath — paths are relative to the
          changeSet file. CSV headers must match column names.
 WHY:     The student copy ships an empty DB; the trainer copy ships seeded
          data so demos work the moment the app boots.
 OBSERVE: SELECT count(*) FROM counterparties → 10. trades → 500.
          users → 4 (admin/trader/viewer/recon analyst).
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="008-seed-counterparties" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM counterparties</sqlCheck>
        </preConditions>
    <changeSet id="008-seed-counterparties" author="trainer">
        <loadData file="data/counterparties.csv" tableName="counterparties"
                  separator="," relativeToChangelogFile="true">
            <column name="id" type="NUMERIC"/>
            <column name="name" type="STRING"/>
            <column name="lei_code" type="STRING"/>
            <column name="region" type="STRING"/>
        </loadData>
        <rollback>
            <sql>DELETE FROM counterparties;</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-seed-instruments" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM instruments</sqlCheck>
        </preConditions>
    <changeSet id="008-seed-instruments" author="trainer">
        <loadData file="data/instruments.csv" tableName="instruments"
                  separator="," relativeToChangelogFile="true">
            <column name="id" type="NUMERIC"/>
            <column name="symbol" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="asset_class" type="STRING"/>
            <column name="currency" type="STRING"/>
            <column name="isin" type="STRING"/>
        </loadData>
        <rollback>
            <sql>DELETE FROM instruments;</sql>
        </rollback>
    </changeSet>

    <!-- Five named instruments above plus 45 deterministic generated rows. -->
    <changeSet id="008-generate-instruments-postgresql" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <and>
                <dbms type="postgresql"/>
                <sqlCheck expectedResult="5">SELECT COUNT(*) FROM instruments</sqlCheck>
            </and>
        </preConditions>
        <sql><![CDATA[
            INSERT INTO instruments (id, symbol, name, asset_class, currency, isin)
            SELECT
                g + 5,
                'GEN' || LPAD(g::text, 4, '0'),
                'Generated Instrument ' || g,
                (ARRAY['EQUITY','FIXED_INCOME','FX','COMMODITY','DERIVATIVE'])[1 + ((g - 1) % 5)],
                (ARRAY['USD','EUR','GBP','JPY','CHF'])[1 + ((g - 1) % 5)],
                NULL
            FROM generate_series(1, 45) AS g;
        ]]></sql>
        <rollback>
            <sql>DELETE FROM instruments WHERE id BETWEEN 6 AND 50;</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-generate-instruments-h2" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <and>
                <dbms type="h2"/>
                <sqlCheck expectedResult="5">SELECT COUNT(*) FROM instruments</sqlCheck>
            </and>
        </preConditions>
        <sql><![CDATA[
            INSERT INTO instruments (id, symbol, name, asset_class, currency, isin)
            SELECT
                x + 5,
                'GEN' || LPAD(CAST(x AS VARCHAR), 4, '0'),
                'Generated Instrument ' || CAST(x AS VARCHAR),
                CASE MOD(x - 1, 5)
                    WHEN 0 THEN 'EQUITY'
                    WHEN 1 THEN 'FIXED_INCOME'
                    WHEN 2 THEN 'FX'
                    WHEN 3 THEN 'COMMODITY'
                    ELSE 'DERIVATIVE'
                END,
                CASE MOD(x - 1, 5)
                    WHEN 0 THEN 'USD'
                    WHEN 1 THEN 'EUR'
                    WHEN 2 THEN 'GBP'
                    WHEN 3 THEN 'JPY'
                    ELSE 'CHF'
                END,
                NULL
            FROM SYSTEM_RANGE(1, 45);
        ]]></sql>
        <rollback>
            <sql>DELETE FROM instruments WHERE id BETWEEN 6 AND 50;</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-seed-trades-postgresql" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <and>
                <dbms type="postgresql"/>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM trades</sqlCheck>
            </and>
        </preConditions>
        <sql><![CDATA[
            INSERT INTO trades
                (trade_ref, instrument_id, counterparty_id, asset_class, side,
                 quantity, price, trade_date, status)
            SELECT
                'TRD-2026-' || LPAD(n::text, 6, '0'),
                1 + (n % 50),
                1 + (n % 10),
                (SELECT asset_class FROM instruments WHERE id = 1 + (n % 50)),
                CASE WHEN n % 2 = 0 THEN 'BUY' ELSE 'SELL' END,
                (100 + (n % 10000))::numeric(18,4),
                (25 + ((n * 17) % 500))::numeric(18,4),
                DATE '2026-04-01' + (n % 120),
                (ARRAY['PENDING','MATCHED','UNMATCHED','DISPUTED','MATCHED'])[1 + (n % 5)]
            FROM generate_series(1, 500) AS n;
        ]]></sql>
        <rollback>
            <sql>DELETE FROM trades WHERE trade_ref LIKE 'TRD-2026-%';</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-seed-trades-h2" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <and>
                <dbms type="h2"/>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM trades</sqlCheck>
            </and>
        </preConditions>
        <sql><![CDATA[
            INSERT INTO trades
                (trade_ref, instrument_id, counterparty_id, asset_class, side,
                 quantity, price, trade_date, status)
            SELECT
                'TRD-2026-' || LPAD(CAST(x AS VARCHAR), 6, '0'),
                1 + MOD(x, 50),
                1 + MOD(x, 10),
                (SELECT asset_class FROM instruments WHERE id = 1 + MOD(x, 50)),
                CASE WHEN MOD(x, 2) = 0 THEN 'BUY' ELSE 'SELL' END,
                CAST(100 + MOD(x, 10000) AS NUMERIC(18,4)),
                CAST(25 + MOD(x * 17, 500) AS NUMERIC(18,4)),
                DATEADD('DAY', MOD(x, 120), DATE '2026-04-01'),
                CASE MOD(x, 5)
                    WHEN 0 THEN 'PENDING'
                    WHEN 1 THEN 'MATCHED'
                    WHEN 2 THEN 'UNMATCHED'
                    WHEN 3 THEN 'DISPUTED'
                    ELSE 'MATCHED'
                END
            FROM SYSTEM_RANGE(1, 500);
        ]]></sql>
        <rollback>
            <sql>DELETE FROM trades WHERE trade_ref LIKE 'TRD-2026-%';</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-seed-recon-breaks" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM recon_breaks</sqlCheck>
        </preConditions>
        <sql><![CDATA[
            INSERT INTO recon_breaks (trade_id, discrepancy_type, status)
            SELECT id,
                   CASE MOD(id, 3)
                       WHEN 0 THEN 'PRICE_MISMATCH'
                       WHEN 1 THEN 'QUANTITY_MISMATCH'
                       ELSE 'DATE_MISMATCH'
                   END,
                   'OPEN'
            FROM trades
            WHERE status IN ('UNMATCHED', 'DISPUTED')
            FETCH FIRST 30 ROWS ONLY;
        ]]></sql>
        <rollback>
            <sql>DELETE FROM recon_breaks WHERE status = 'OPEN';</sql>
        </rollback>
    </changeSet>

    <changeSet id="008-seed-users" author="trainer" context="dev,test">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM users</sqlCheck>
